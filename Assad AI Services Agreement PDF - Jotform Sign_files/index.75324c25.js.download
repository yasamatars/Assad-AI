    border: 0;
    background-color: ${ew=>ew.theme.chSelected};

    &:after { transform: scale(1) rotate(0); }
  }

  [aria-selected="partial"] & {
    border: 0;
    background-color: ${ew=>ew.theme.chSelected};

    &:after { background: url("${ew=>ew.theme.chPartialIcon}") no-repeat center; transform: scale(1) rotate(0); }
  }
