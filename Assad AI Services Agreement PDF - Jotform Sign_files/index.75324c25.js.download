  background-color: #fff;

  &:after {
    content: "";
    display: block;
    background: url("${ew=>ew.theme.chIcon}") no-repeat center;
  }

  input[type=checkbox], &:after {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0; left: 0;
    margin: 0;
    padding: 0;
  }

  input[type=checkbox] { opacity: 0; }

