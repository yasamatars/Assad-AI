      0% {
        stroke-dashoffset: 10px;
      }
      15% {
        stroke-dashoffset: 10px;
      }
      25% {
        stroke-dashoffset: 0;
      }
      100% {
        stroke-dashoffset: 0;
      }
    }
    @keyframes drawLine2 {
      0% {
        stroke-dashoffset: 10px;
      }
      10% {
        stroke-dashoffset: 10px;
      }
      20% {
        stroke-dashoffset: 0;
      }
      100% {
        stroke-dashoffset: 0;
      }
    }
    @keyframes drawLine1 {
      0% {
        stroke-dashoffset: 10px;
      }
      5% {
        stroke-dashoffset: 10px;
      }
      15% {
        stroke-dashoffset: 0;
      }
      100% {
        stroke-dashoffset: 0;
      }
    }
  }
  .paper {
    animation-name: scalePaper;
    animation-duration: 1.5s;
    animation-fill-mode: backwards;
    animation-iteration-count: infinite;
    transform-origin: center;
    animation-timing-function: cubic-bezier(0.01, 0.63, 0.1, 0.99);
    @keyframes scalePaper {
      0% {
        transform: scale(1);
      }
      10% {
        transform: scale(1);
      }
      20% {
        transform: scale(1.2);
      }
      30% {
        transform: scale(1);
      }
      100% {
        transform: scale(1);
      }
    }
  }
