`,rY=tS()(az)`
  .itemDesc {
    position: relative;
  }

  &.isDisabled {
    &:hover {
      .errorText {
        display: block;
      }
    }
  }

  .errorText {
    display: none;
    position: absolute;
    left: 93px;
    bottom: 4px;
    font-size: 13px;
    line-height: normal;
    padding: 8px;
    text-transform: lowercase;
    border-radius: 4px;
    color: #fff;
    font-weight: 400;
    background-color: #0A1551;
    font-family: "Circular";

    &:first-letter { text-transform: uppercase; }

    .link {
      color: #0099FF;
      cursor: pointer;
