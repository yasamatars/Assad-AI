width: 100%;
height: 100%;
.mainRectangle, .fold {
  transform-origin: center;
  animation: scale 1.25s 1s infinite;
}
.pen {
  transform: translate(-57px, -2px);
  transform-origin: center;
  animation: draw 1.25s infinite;
}
.linee {
  stroke-dasharray: 50px;
  stroke-dashoffset: 50px;
  &.line1 {
    animation: drawLine1 1.25s cubic-bezier(0.01, 0.63, 0.1, 0.99) infinite backwards;
  }
  &.line2 {
    animation: drawLine2 1.25s cubic-bezier(0.01, 0.63, 0.1, 0.99) infinite backwards;
  }
}
@keyframes drawLine1 {
  0% { stroke-dashoffset: 50px; }
  100% { stroke-dashoffset: 0;  }
}
@keyframes drawLine2 {
  0% { stroke-dashoffset: 50px; }
  25% { stroke-dashoffset: 50px; }
  100% { stroke-dashoffset: 0; }
}
@keyframes draw {
  0% { transform: translate(-57px, -2px); }
  25% { transform: translate(-40px,-11px); }
  50% { transform: translate(-42px,4px); }
  75% { transform: translate(-10px,-7px); }
  100% { transform: translate(0,0); }
}
@keyframes scale {
  0% { transform: scale(1); }
  10% { transform: scale(1.1); }
  20% { transform: scale(1); }
  100% { transform: scale(1); }
}
